rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// MDSoltec OS — regras do Firestore
//
// Antes: modo "teste" (qualquer pessoa lia/escrevia sem login — CPF,
// telefones, estoque e financeiro expostos; uma regra com data já
// expirada em 11/09/2025 confirmava o risco).
// Agora: tudo exige usuário autenticado no Firebase Auth e qualquer
// coleção NÃO listada abaixo fica NEGADA por padrão.
//
// Para criar uma coleção nova, adicione um match explícito aqui.
// Perfis (admin/técnico/atendente/financeiro) continuam tratados no
// app; para reforçar no servidor, use custom claims do Auth.
//
// Publicar:  firebase deploy --only firestore:rules
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Perfis via custom claim "role" (definido com tools/set-user-role.js)
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Perfis da equipe: leitura livre autenticada (o app descobre o cargo
    // no login). Escrita só com claim admin; cada usuário pode renomear
    // o próprio perfil (nome exibido na topbar).
    match /usuarios/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.email);
    }

    // Configurações da empresa (escrita admin) e contador de OS
    // (qualquer autenticado cria OS e precisa incrementar).
    match /config/contadorOS {
      allow read, write: if isSignedIn();
    }
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // PORTAL DO CLIENTE: leitura pública SEM login. O app grava aqui
    // somente dados não sensíveis (status, primeiro nome, aparelho).
    // Nada de CPF, endereço, telefone ou valores.
    match /consultasPublicas/{codigo} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /clientes/{docId} {
      allow read, write: if isSignedIn();
    }

    match /ordensServico/{docId} {
      allow read, write: if isSignedIn();
    }

    match /estoque/{docId} {
      allow read, write: if isSignedIn();
    }

    match /produtos/{docId} {
      allow read, write: if isSignedIn();
    }

    match /vendasPDV/{docId} {
      allow read, write: if isSignedIn();
    }

    match /garantias/{docId} {
      allow read, write: if isSignedIn();
    }

    match /mensagensWhatsapp/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fichasTecnicas/{docId} {
      allow read, write: if isSignedIn();
    }

    // Qualquer outra coleção: sem regra = acesso negado (inclui leitura
    // anônima, escrita anônima e coleções criadas no futuro por engano).
  }
}
